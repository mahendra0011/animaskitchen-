# ==============================================================================
# ANIMA'S KITCHEN — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME (Zaroori)
# ------------------------------------------------------------------------------
PORT=10000
NODE_ENV=production
NITRO_PRESET=node-server
APP_URL=https://animaskitchen.com

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL - Neon / Supabase / Render / Local)
# ------------------------------------------------------------------------------
# Format: postgresql://username:password@hostname:5432/databasename?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/animaskitchen

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION (Must - Kam se kam 32 characters)
# ------------------------------------------------------------------------------
# Session cookie encrypt/sign karne ke liye secret
SESSION_SECRET=your_super_secret_session_key_min_32_chars_long

# Email OTP sha256 hashing salt/pepper (raw OTP leak na ho)
OTP_PEPPER=your_secure_otp_pepper_salt_string_min_32_chars_long

# ------------------------------------------------------------------------------
# 4. EMAIL SERVICE (Email OTP aur Order Invoices ke liye)
# ------------------------------------------------------------------------------
# Resend (https://resend.com) ya Brevo
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuv
EMAIL_FROM="Anima's Kitchen <orders@animaskitchen.com>"

# ------------------------------------------------------------------------------
# 5. PAYMENTS (Razorpay - India Standard)
# ------------------------------------------------------------------------------
# Razorpay Dashboard -> Settings -> API Keys (Test ya Live)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Razorpay Webhooks -> Secret (payment.captured verify karne ke liye)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ------------------------------------------------------------------------------
# 6. MAPS & LOCATION (Google Maps ya Mapbox)
# ------------------------------------------------------------------------------
# Address autocomplete, delivery zone check, rider live tracking
GOOGLE_MAPS_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 7. MEDIA STORAGE (Optional: Dish photos & Bill upload)
# ------------------------------------------------------------------------------
# Cloudinary (https://cloudinary.com)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ------------------------------------------------------------------------------
# 8. MONITORING & BOT PROTECTION (Production Safety)
# ------------------------------------------------------------------------------
# Error tracking Sentry (https://sentry.io)
SENTRY_DSN=https://xxxxxxxx@o0.ingest.sentry.io/0
# OTP form bot attack rokne ke liye Cloudflare Turnstile (Optional)
TURNSTILE_SECRET_KEY=0x4AAAAAAxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 9. APP BRANDING (Frontend display)
# ------------------------------------------------------------------------------
VITE_APP_NAME="Anima's Kitchen"
VITE_APP_TAGLINE="Hot, Warm, Homemade Indian Food & Tiffin"
VITE_KITCHEN_LOCATION="Indiranagar Hub #01, Bengaluru"
